{
  "manifest_version": 3,
  "name": "BGA Assistant",
  "version": "1.4.1",
  "description": "A Chrome extension for Board Game Arena: tracks game state (Innovation, Azul, The Crew) and play time on every game, plus UI tweaks.",
  "homepage_url": "https://anothersava.github.io/bga-assistant/",
  "permissions": ["activeTab", "alarms", "idle", "scripting", "sidePanel", "storage", "tabs", "webNavigation"],
  "host_permissions": ["https://boardgamearena.com/*", "https://*.boardgamearena.com/*"],
  "action": {
    "default_icon": {
      "16": "assets/extension/icon-16-0.png",
      "48": "assets/extension/icon-48-0.png",
      "128": "assets/extension/icon-128-0.png"
    },
    "default_title": "BGA Assistant"
  },
  "icons": {
    "16": "assets/extension/icon-16-0.png",
    "48": "assets/extension/icon-48-0.png",
    "128": "assets/extension/icon-128-0.png"
  },
  "commands": {
    "toggle-sidepanel": {
      "description": "Toggle side panel"
    }
  },
  "minimum_chrome_version": "141",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/bga/innovation/cards/*.webp"],
      "matches": ["https://boardgamearena.com/*", "https://*.boardgamearena.com/*"]
    }
  ]
}
